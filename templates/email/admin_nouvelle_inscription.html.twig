{% extends 'email/base.html.twig' %}
{% block content %}
<h1 style="margin:0 0 12px;font-size:22px;color:#1b2a6b;">Nouvelle inscription à vérifier</h1>
<p style="margin:0 0 16px;">Une inscription vient d'être enregistrée. Vérifiez la réception du paiement, puis validez-la ou rejetez-la.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f7f8fc;border-radius:12px;border:1px solid #e0e5f2;">
  <tr><td style="padding:16px 18px;font-size:14px;line-height:1.9;">
    <strong>Participant :</strong> {{ inscription.utilisateur.nomComplet }} ({{ inscription.utilisateur.email }})<br>
    <strong>Institution :</strong> {{ inscription.institution }}<br>
    <strong>Catégorie :</strong> {{ inscription.categorie.libelle }}<br>
    <strong>Montant attendu :</strong> {{ inscription.montantTotal|number_format(0, ',', ' ') }} FCFA{% if inscription.repas %} <span style="color:#5b6b86;">(dont déjeuner : {{ inscription.colloque.prixRepas|number_format(0, ',', ' ') }} FCFA)</span>{% endif %}
    {% if paiement %}<br><strong>Canal :</strong> {{ paiement.canal.label }}<br>
    <strong>Référence :</strong> {{ paiement.reference ?? 'non renseignée' }}<br>
    <strong>Reçu joint :</strong> {{ paiement.justificatif ? 'oui' : 'non' }}{% endif %}
  </td></tr>
</table>
{% include 'email/_button.html.twig' with { url: frontUrl ~ '/admin/validations', label: 'Ouvrir les validations' } %}
{% endblock %}
