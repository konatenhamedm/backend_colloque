{# Layout commun des e-mails. Styles en ligne + tableaux : seul moyen fiable dans Gmail/Outlook. #}
<!DOCTYPE html>
<html lang="fr">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{% block title %}{{ colloque.titre|default('Colloque') }}{% endblock %}</title></head>
<body style="margin:0;padding:0;background:#f3f5fb;font-family:Arial,Helvetica,sans-serif;color:#101a3d;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f5fb;padding:24px 12px;">
  <tr><td align="center">
    <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid #e0e5f2;">
      {# Bandeau tricolore #}
      <tr><td style="height:6px;line-height:6px;font-size:0;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
          <td width="40%" style="background:#2f55c4;height:6px;font-size:0;">&nbsp;</td>
          <td width="30%" style="background:#d9730d;height:6px;font-size:0;">&nbsp;</td>
          <td width="30%" style="background:#1f8a3b;height:6px;font-size:0;">&nbsp;</td>
        </tr></table>
      </td></tr>
      {# En-tête #}
      <tr><td style="background:#0f1a4a;padding:26px 32px;">
        <div style="font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#f0a35a;font-weight:bold;">{{ colloque.titre|default('Inscription') }}{% if colloque.sousTitre is defined and colloque.sousTitre %} · {{ colloque.sousTitre }}{% endif %}</div>
        <div style="margin-top:8px;font-size:20px;line-height:1.3;color:#ffffff;font-weight:bold;">« {{ colloque.theme|default(colloque.titre|default('')) }} »</div>
        {% if colloque.lieu is defined %}
        <div style="margin-top:10px;font-size:13px;color:#aab6e4;">{{ colloque.dateDebut|date('d/m/Y') }}{% if colloque.heures %} · {{ colloque.heures }}{% endif %} · {{ colloque.lieu }}</div>
        {% endif %}
      </td></tr>
      {# Contenu #}
      <tr><td style="padding:32px;font-size:15px;line-height:1.65;color:#101a3d;">
        {% block content %}{% endblock %}
      </td></tr>
      {# Pied de page #}
      <tr><td style="background:#f7f8fc;border-top:1px solid #e0e5f2;padding:20px 32px;font-size:12px;line-height:1.6;color:#5a6788;">
        {% block footer %}{% endblock %}
        <div>
          {% if colloque.contacts.email is defined %}Contact : <a href="mailto:{{ colloque.contacts.email }}" style="color:#1b2a6b;font-weight:bold;">{{ colloque.contacts.email }}</a>{% endif %}
          {% if colloque.contacts.telephones is defined and colloque.contacts.telephones|length %}<br>{{ colloque.contacts.telephones|join(' · ') }}{% endif %}
        </div>
      </td></tr>
    </table>
    <div style="margin-top:14px;font-size:11px;color:#8f9ab8;">Cet e-mail vous a été envoyé automatiquement, merci de ne pas y répondre directement.</div>
  </td></tr>
</table>
</body>
</html>
