{% extends 'email/base.html.twig' %}
{% block content %}
<h1 style="margin:0 0 12px;font-size:22px;color:#c0392b;">Votre paiement n'a pas pu être validé</h1>
<p style="margin:0 0 8px;">Bonjour {{ inscription.utilisateur.prenom }},</p>
<p style="margin:0 0 16px;">Nous n'avons pas pu valider votre paiement pour le motif suivant :</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
  <td style="background:#fdecea;border-left:4px solid #c0392b;border-radius:8px;padding:14px 18px;font-size:14px;line-height:1.6;">{{ motif }}</td>
</tr></table>
<p style="margin:18px 0 0;">Vous pouvez corriger votre dossier et renvoyer une preuve de paiement depuis votre espace.</p>
{% include 'email/_button.html.twig' with { url: frontUrl ~ '/espace', label: 'Corriger mon paiement' } %}
{% endblock %}
