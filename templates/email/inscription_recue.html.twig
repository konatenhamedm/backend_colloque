{% extends 'email/base.html.twig' %}
{% block content %}
<h1 style="margin:0 0 12px;font-size:22px;color:#1b2a6b;">Félicitations, vous êtes inscrit(e) ! 🎉</h1>
<p style="margin:0 0 8px;">Bonjour {{ inscription.utilisateur.prenom }},</p>
<p style="margin:0 0 16px;">Votre inscription au forum est bien enregistrée. Il n'y a rien d'autre à faire : les organisateurs vérifient simplement votre paiement, et vous recevrez un nouveau message dès que ce sera validé.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f7f8fc;border-radius:12px;border:1px solid #e0e5f2;">
  <tr><td style="padding:16px 18px;font-size:14px;line-height:1.9;">
    <strong>Catégorie :</strong> {{ inscription.categorie.libelle }}<br>
    <strong>Montant :</strong> {{ inscription.montantTotal|number_format(0, ',', ' ') }} FCFA{% if inscription.repas %} <span style="color:#5b6b86;">(dont déjeuner : {{ inscription.colloque.prixRepas|number_format(0, ',', ' ') }} FCFA)</span>{% endif %}
  </td></tr>
</table>
<p style="margin:18px 0 0;">Dès que votre paiement sera validé, vous recevrez par e-mail votre <strong>reçu de paiement</strong>, à imprimer et à présenter le jour de l'événement.</p>
{% include 'email/_button.html.twig' with { url: frontUrl ~ '/connexion', label: 'Accéder à mon espace' } %}
{% endblock %}
