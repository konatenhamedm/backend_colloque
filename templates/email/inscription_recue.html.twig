{% extends 'email/base.html.twig' %}
{% block content %}
<h1 style="margin:0 0 12px;font-size:22px;color:#1b2a6b;">Inscription enregistrée ✔</h1>
<p style="margin:0 0 8px;">Bonjour {{ inscription.utilisateur.prenom }},</p>
<p style="margin:0 0 16px;">Nous avons bien reçu votre inscription et votre preuve de paiement. Les organisateurs vont maintenant la vérifier.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f7f8fc;border-radius:12px;border:1px solid #e0e5f2;">
  <tr><td style="padding:16px 18px;font-size:14px;line-height:1.9;">
    <strong>Catégorie :</strong> {{ inscription.categorie.libelle }}<br>
    <strong>Montant :</strong> {{ inscription.categorie.montant|number_format(0, ',', ' ') }} FCFA
  </td></tr>
</table>
<p style="margin:18px 0 0;">Dès que votre paiement sera validé, vous recevrez par e-mail votre <strong>reçu de paiement</strong>, à imprimer et à présenter le jour de l'événement.</p>
{% include 'email/_button.html.twig' with { url: frontUrl ~ '/connexion', label: 'Suivre mon inscription' } %}
{% endblock %}
