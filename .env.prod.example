# À copier sur le serveur dans /var/www/backforum.instapoint.site/web/.env.local  (JAMAIS dans git)
# Le déploiement refuse de continuer si ces clés manquent ou si les secrets sont encore ceux de dev.
APP_ENV=prod
APP_SECRET=<chaîne aléatoire 32+ caractères : openssl rand -hex 32>
JWT_SECRET=<chaîne aléatoire 32+ caractères : openssl rand -hex 32>
JWT_TTL=86400

DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@127.0.0.1:5432/forum?serverVersion=16&charset=utf8"

# Front (liens dans les e-mails) et CORS (regex : n'autorise QUE le front).
# Certificats SSL pas encore actifs -> http. Passer à https:// (FRONT_URL) quand ils le seront ; la regex accepte déjà les deux.
FRONT_URL=http://forum.instapoint.site
CORS_ALLOW_ORIGIN='^https?://forum\.instapoint\.site$'

# E-mails : l'expéditeur doit appartenir au compte SMTP
MAILER_DSN="smtps://utilisateur%40domaine.com:MOT_DE_PASSE@smtp.domaine.com:465"
MAILER_FROM_ADDRESS="forum@instapoint.site"
MAILER_FROM_NAME="Forum"
ADMIN_NOTIFICATION_EMAIL=organisateur@exemple.com

ENFORCE_DEADLINES=1
ATTESTATION_TEMPLATE=classique
PRIVATE_DIR=var/data
